#!/usr/bin/env bash

# List open herdr workspaces and select via fzf
if ! command -v jq >/dev/null 2>&1 || ! command -v fzf >/dev/null 2>&1; then
    echo "jq and fzf are required" >&2
    exit 1
fi

workspaces_json=$(herdr workspace list 2>/dev/null)
if [[ -z "$workspaces_json" ]]; then
    exit 0
fi

selected=$(echo "$workspaces_json" | jq -r '.result.workspaces[]? | "\(.number): \(.label)\t\(.workspace_id)"' | fzf --with-nth=1 --delimiter=$'\t' --prompt="Select Workspace> ")

if [[ -z "$selected" ]]; then
    exit 0
fi

ws_id=$(echo "$selected" | cut -f2)
if [[ -n "$ws_id" ]]; then
    herdr workspace focus "$ws_id" >/dev/null 2>&1
fi
